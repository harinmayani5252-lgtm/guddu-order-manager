# Guddu Order Manager — optional cloud sync
# This is a pure static app: it needs NO build step and NO server env vars.
# Cloud sync is configured INSIDE the app (Settings → Cloud Sync), not here.
#
# These values are provided only for reference / documentation. Get them from:
#   Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
